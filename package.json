{
  "name": "@fastagent-sh/vn",
  "version": "0.23.2",
  "description": "CLI: voice recordings → diarized transcripts → integrated semantic Markdown notes. The desktop app ships separately.",
  "type": "module",
  "license": "MIT",
  "author": "fastagent-sh",
  "homepage": "https://github.com/fastagent-sh/voicenote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastagent-sh/voicenote.git"
  },
  "bugs": {
    "url": "https://github.com/fastagent-sh/voicenote/issues"
  },
  "keywords": [
    "voice",
    "voicenote",
    "transcription",
    "diarization",
    "meeting-notes",
    "philips",
    "cli"
  ],
  "bin": {
    "vn": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "doctor": "node src/cli.ts doctor",
    "prepublishOnly": "bun run typecheck && bun test ./src && bun run build",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "cac": "latest",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=24"
  }
}
