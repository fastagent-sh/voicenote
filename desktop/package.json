{
  "name": "voicenote",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.json && electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "electron-updater": "^6.8.9",
    "marked": "^16.4.2",
    "undici": "^8"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "electron": "44.4.3",
    "electron-builder": "^26",
    "electron-vite": "^4",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5",
    "vite": "^7"
  },
  "description": "VoiceNote desktop app: recordings in, semantic notes out.",
  "build": {
    "appId": "sh.fastagent.voicenote",
    "productName": "VoiceNote",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@earendil-works/pi-coding-agent/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "node_modules/@ffprobe-installer/darwin-arm64/ffprobe",
          "to": "ffprobe"
        }
      ]
    },
    "electronLanguages": [
      "en",
      "zh_CN"
    ],
    "extraResources": [
      "resources/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fastagent-sh",
        "repo": "voicenote"
      }
    ],
    "afterPack": "build/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "node_modules/@ffprobe-installer/win32-x64/ffprobe.exe",
          "to": "ffprobe.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "optionalDependencies": {
    "@ffprobe-installer/darwin-arm64": "^5.0.1",
    "@ffprobe-installer/win32-x64": "^5.1.0"
  }
}
